meta {
  name: CS Lexicon
  type: http
  seq: 2
}

post {
  url: {{ruleBasedUrl}}/get-lexicon-terms
  body: json
  auth: inherit
}

body:json {
  {
    "text": "Forenzní nástroje byly použity k provedení úplné extrakce zařízení. Důkazy jsme umístili do Faradayovy klece, abychom zabránili vzdálenému přístupu. Šifrování na zařízení bylo povoleno. Tým digitální forenzní analýza potřeboval přístup k SIM karta a EXIF data z fotografií. Pevný disk obsahoval citlivá digitální data.",
    "language": "cs"
  }
}

tests {
  test("Status should be 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  const expectedPhrases = [
    "forenzní",
    "extrakce",
    "šifrování",
    "digitální forenzní analýza",
    "sim",
    "exif",
    "pevný disk",
    "digitální data"
  ];
  
  expectedPhrases.forEach(phrase => {
    test(`Phrase '${phrase}' should be detected`, function () {
      const found = res.body.some(item => item.word?.toLowerCase().includes(phrase.toLowerCase()));
      expect(found).to.be.true;
    });
  });
  
  test("Each detected phrase should have a usage example", function () {
    res.body.forEach(item => {
      expect(item.usage_example).to.exist;
      // Usage example can be empty if not available in source data
    });
  });
  
  test("Each detected phrase should have character positions", function () {
    res.body.forEach(item => {
      expect(item.character_positions).to.exist;
      expect(item.character_positions.start).to.be.a('number');
      expect(item.character_positions.end).to.be.a('number');
    });
  });
  
  console.log(res.body);
}
